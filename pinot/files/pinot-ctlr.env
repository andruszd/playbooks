
export HADOOP_HOME=/usr/lib/hadoop
export HADOOP_VERSION=3.3.5
export HADOOP_GUAVA_VERSION=27.0
export HADOOP_GSON_VERSION=2.2.4
export GC_LOG_LOCATION=/var/log/java/
export PINOT_VERSION=1.0.0
export PINOT_DISTRIBUTION_DIR=/opt/pinot/
export SERVER_CONF_DIR=/etc/pinot/conf/
export ZOOKEEPER_ADDRESS="zookafka:2181"
export CLUSTER_NAME=development


#export CLASSPATH_PREFIX="/usr/lib/hadoop-hdfs/hadoop-hdfs-${HADOOP_VERSION}.jar:/usr/lib/hadoop/hadoop-annotations-${HADOOP_VERSION}.jar:/usr/lib/hadoop/hadoop-auth-${HADOOP_VERSION}.jar:/usr/lib/hadoop/hadoop-common-${HADOOP_VERSION}.jar:/usr/lib/hadoop/lib/guava-${HADOOP_GUAVA_VERSION}.jar:/usr/lib/hadoop/lib/gson-${HADOOP_GSON_VERSION}.jar"
export JAVA_OPTS="-Xms8G -Xmx12G -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Xloggc:${GC_LOG_LOCATION}/gc-pinot-controller.log -Dlog4j2.configurationFile=/etc/pinot/conf/pinot-controller-log4j2.xml"


